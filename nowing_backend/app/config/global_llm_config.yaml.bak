router_settings:
  routing_strategy: "simple-shuffle"
  num_retries: 0
  allowed_fails: 1
  cooldown_time: 1

global_llm_configs:
  - id: -1
    name: "ChainLens Proxy Gemini 3.7 Flash High"
    billing_tier: "free"
    anonymous_enabled: false
    seo_enabled: false
    quality_score: 1.0
    litellm_provider: "openai"
    model_name: "agy/gemini-3.7-flash-high"
    api_base: "https://proxy.chainlens.net/v1"
    supports_image_input: true
    supports_tools: true
    quota_reserve_tokens: 1024
    rpm: 1000
    tpm: 100000
    is_planner: true
    litellm_params:
      model: "openai/agy/gemini-3.7-flash-high"
      temperature: 0.3
