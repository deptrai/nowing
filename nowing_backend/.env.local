# Local overrides copied from .env.example
# Default embedding model. For local dev with Ollama, use litellm://ollama/nomic-embed-text.
EMBEDDING_MODEL=litellm://ollama/nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_BASE_URL=http://localhost:11434

# Rerankers Config
RERANKERS_ENABLED=TRUE
RERANKERS_MODEL_NAME=ms-marco-MiniLM-L-12-v2
RERANKERS_MODEL_TYPE=flashrank

# ChainLens local dev: point at the MCP-service-enabled instance and sign HMAC headers.
CHAINLENS_API_URL=http://localhost:3002
CHAINLENS_AUTH_CONTEXT_SECRET=ZqabcsU5c4gLR5Yc9mApWKdZN83SdTZefHWgXSsGQjh6ULy6EFr0g5dNP9VaYFU
CHAINLENS_HMAC_USER_ID=00000000-0000-0000-0000-000000000001

# Local dev server ports
UVICORN_PORT=4445
NEXT_FRONTEND_URL=http://localhost:4444
