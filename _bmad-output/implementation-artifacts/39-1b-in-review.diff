+# ---------------------------------------------------------------------------
+# Malformed payloads → InvalidDecisionAnswer (never retried)
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.unit
+async def test_decide_invalid_json_raises_invalid(monkeypatch):
+    _patch_acompletion(monkeypatch, _FakeResponse("not json at all"))
