+# enable auto-extract on a paid model, set MEMORY_AUTO_EXTRACT_BUDGET_MICROS.
+#
+# Minimum spendable balance (micro-USD, i.e. 1_000_000 = $1) the workspace owner
+# must have for an extraction to be attempted. Always on. Clamped to >= 1; use 1
+# to mean "only skip a completely empty wallet".
+# MEMORY_AUTO_EXTRACT_MIN_RESERVE_MICROS=100
+#
+# Per-workspace ceiling (micro-USD) on summed ``memory_create`` cost within the
+# rolling window below. 0 = disabled, no budget gating. Ships disabled because
+# AD-8 forbids fixing a cost figure before story 8-7 produces measured numbers;
+# set a real value once you have measured your own cost/turn.
+# MEMORY_AUTO_EXTRACT_BUDGET_MICROS=0
+#
+# Rolling lookback for the budget cap: day (24h), week (7d) or month (flat 30d).
+# Rolling, not calendar, so a burst right after midnight cannot slip through.
+# An unrecognised value logs a warning and falls back to "day".
+# MEMORY_AUTO_EXTRACT_BUDGET_WINDOW=day
+#
+# Max extractions per workspace per window. 0 = disabled, no throttling. Backed
+# by a Redis fixed-window counter (key nowing:memory_extract_rate:<workspace_id>)
+# with a per-worker in-memory fallback when Redis is unreachable. This is an
+# abuse guard, not the cost guard — it fails open.
+# MEMORY_AUTO_EXTRACT_RATE_MAX=0
+# MEMORY_AUTO_EXTRACT_RATE_WINDOW_SECONDS=3600
+
+# Nowing Deep Research — hosted deep-research engine (cloud-only in self-host Phase 1).
+# Leaving CHAINLENS_API_KEY empty or unset is valid for self-host: the capability
+# will degrade to the workspace knowledge base. Set both to enable cloud deep research.
+# CHAINLENS_API_KEY=
+# CHAINLENS_API_URL=https://api.chainlens.net
