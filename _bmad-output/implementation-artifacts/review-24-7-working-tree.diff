+        String(64),
+        nullable=False,
+        default="deep_lead_research",
+    )
+    status = Column(
+        String(16),
+        nullable=False,
+        default="pending",
+        server_default="pending",
+        index=True,
+    )
+    phase = Column(String(32), nullable=True)
