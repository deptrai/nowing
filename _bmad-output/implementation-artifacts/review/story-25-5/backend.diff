+    model_config = ConfigDict(from_attributes=True)
+
+    id: int
+    created_by_user_id: UUID | None
+    updated_by_user_id: UUID | None
+    created_at: datetime
+    updated_at: datetime
+
+
+class ScraperRuleListItem(BaseModel):
