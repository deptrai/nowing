+
+      - name: Set safe service name
+        id: safe
+        run: |
+          SAFE_SERVICE=$(echo '${{ matrix.service }}' | tr '/' '-')
+          echo "service=$SAFE_SERVICE" >> "$GITHUB_OUTPUT"
