+def test_build_transcript_query_truncates_boundary_record_with_trailing_space_marker() -> (
+    None
+):
+    old_text = "OLD" * 2000
+    messages = [
+        HumanMessage(content=old_text),
+        HumanMessage(content="Recent short question."),
