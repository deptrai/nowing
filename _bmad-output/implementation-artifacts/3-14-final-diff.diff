+    tail_start = n
+    tail_len = 0
+    while tail_start > head_end:
+        atom_len = len(atoms[tail_start - 1])
+        if tail_len + atom_len > tail_budget:
+            break
+        tail_len += atom_len
+        tail_start -= 1
