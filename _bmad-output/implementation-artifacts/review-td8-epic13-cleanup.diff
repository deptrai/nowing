-            CanonicalEntity.embedding_status == EmbeddingStatus.READY.value,
-        ]
-
-        semantic_search_cte = (
-            select(
-                CanonicalEntity.id,
-                func.row_number()
-                .over(
-                    order_by=[
-                        CanonicalEntity.embedding.op("<=>")(query_embedding),
-                        CanonicalEntity.id,
