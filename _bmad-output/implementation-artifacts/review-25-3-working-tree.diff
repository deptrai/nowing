+    async def _get_payout(self, payout_id: uuid.UUID) -> PartnerPayout:
+        stmt = select(PartnerPayout).where(PartnerPayout.id == payout_id)
+        res = await self.session.execute(stmt)
+        payout = res.scalar_one_or_none()
