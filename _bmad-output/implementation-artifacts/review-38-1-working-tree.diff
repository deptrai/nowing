@@ -0,0 +1,52 @@
+# =============================================================================
+# LiveKit SIP Gateway Configuration
+# Story 38.1 / Invariant AD-122
+# Bridges domestic SIP Trunks (G.711a PCMA 8kHz) with LiveKit WebRTC SFU (Opus 48kHz).
+# =============================================================================
+
+# LiveKit Server Authentication & Signaling
+api_key: ${LIVEKIT_API_KEY}
+api_secret: ${LIVEKIT_API_SECRET}
+ws_url: ${LIVEKIT_URL}
+
+# Internal Redis Coordination
+redis:
+  address: ${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
+  password: ${REDIS_PASSWORD:-}
+  db: 0
+
+# SIP Signaling Network
+sip_port: 5060
+sip_port_listen: 5060
+sip_hostname: ${SIP_GATEWAY_HOST:-livekit-sip}
+
+# RTP Audio Stream Port Range (Invariant AD-122: Direct internal routing)
+rtp_port:
+  start: 10000
+  end: 20000
+
+# Audio Codec & Transcoding Configuration
+# Bi-directional transcoding: G.711 A-law (PCMA 8kHz) for SIP Trunk <-> Opus 48kHz for WebRTC SFU
+audio:
+  codecs:
+    - pcma # G.711 A-law 8kHz
+    - opus # WebRTC Opus 48kHz
+  sample_rate: 48000
+  channels: 1
+
+# Room Dispatch & Mapping Template
+# Automatically creates room call_<session_uuid> upon receiving SIP INVITE
+room_prefix: "call_"
+room_template: "call_{uuid}"
+
+# Performance & Reliability Limits
+max_active_calls: 100
+max_cpu_utilization: 0.9
+media_timeout: 60s
+media_timeout_initial: 5s
+enable_jitter_buffer: false
+
+# Monitoring & Logging
+log_level: info
+health_port: 8081
+prometheus_port: 8082
