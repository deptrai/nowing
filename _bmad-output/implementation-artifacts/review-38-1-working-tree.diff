diff --git a/docker/docker-compose.telephony.yml b/docker/docker-compose.telephony.yml
new file mode 100644
index 000000000..dbdea51de
--- /dev/null
+++ b/docker/docker-compose.telephony.yml
@@ -0,0 +1,68 @@
+# =============================================================================
+# Nowing Telephony & Voice AI Infrastructure Stack
+# Story 38.1 / Invariant AD-122: Kamailio SBC Edge & LiveKit SIP Gateway Cluster
+# Direct host/internal RTP routing (10000-20000/UDP), no Caddy/Traefik reverse proxy.
+# =============================================================================
+
+name: nowing-telephony
+
+services:
+  kamailio:
+    image: kamailio/kamailio:5.8.3
+    container_name: nowing-kamailio
+    restart: unless-stopped
+    ports:
+      - "5060:5060/udp"
+      - "5060:5060/tcp"
+    volumes:
+      - ./kamailio/kamailio.cfg:/etc/kamailio/kamailio.cfg:ro
+      - ./kamailio/dispatcher.list:/etc/kamailio/dispatcher.list:ro
+    environment:
+      - SIP_PORT=5060
+      - KAMAILIO_LOG_LEVEL=2
+    networks:
+      - telephony_net
+    depends_on:
+      - livekit-sip-1
+      - livekit-sip-2
+
+  livekit-sip-1:
+    image: livekit/sip:latest
+    container_name: nowing-livekit-sip-1
+    restart: unless-stopped
+    volumes:
+      - ./livekit/sip.yaml:/etc/livekit/sip.yaml:ro
+    environment:
+      - LIVEKIT_URL=${LIVEKIT_URL:-http://livekit:7880}
+      - LIVEKIT_API_KEY=${LIVEKIT_API_KEY:-devkey}
+      - LIVEKIT_API_SECRET=${LIVEKIT_API_SECRET:-secret}
+      - SIP_CONFIG_FILE=/etc/livekit/sip.yaml
+    ports:
+      - "10000-15000:10000-15000/udp"
+    networks:
+      telephony_net:
+        aliases:
+          - livekit-sip-1
+
+  livekit-sip-2:
+    image: livekit/sip:latest
+    container_name: nowing-livekit-sip-2
+    restart: unless-stopped
+    volumes:
+      - ./livekit/sip.yaml:/etc/livekit/sip.yaml:ro
+    environment:
+      - LIVEKIT_URL=${LIVEKIT_URL:-http://livekit:7880}
+      - LIVEKIT_API_KEY=${LIVEKIT_API_KEY:-devkey}
+      - LIVEKIT_API_SECRET=${LIVEKIT_API_SECRET:-secret}
+      - SIP_CONFIG_FILE=/etc/livekit/sip.yaml
+    ports:
+      - "15001-20000:15001-20000/udp"
+    networks:
+      telephony_net:
+        aliases:
+          - livekit-sip-2
+
+networks:
+  telephony_net:
+    name: nowing_telephony_net
+    driver: bridge
diff --git a/docker/kamailio/kamailio.cfg b/docker/kamailio/kamailio.cfg
new file mode 100644
index 000000000..b4173f826
--- /dev/null
+++ b/docker/kamailio/kamailio.cfg
@@ -0,0 +1,181 @@
+#!KAMAILIO
+# =============================================================================
+# Nowing Telecom SBC - Kamailio Configuration
+# Story 38.1 / Invariant AD-122: Direct internal routing, sub-3ms latency,
+# domestic carrier whitelist, G.711a (PCMA) / Opus audio, 2s OPTIONS healthcheck.
+# =============================================================================
+
+####### Global Parameters #########
+debug=2
+log_stderror=yes
+log_facility=LOG_LOCAL0
+
+fork=yes
+children=4
+
+listen=udp:0.0.0.0:5060
+listen=tcp:0.0.0.0:5060
+
+tcp_connection_lifetime=3600
+tcp_accept_no_cl=yes
+
+####### Modules Section ########
+loadmodule "kex.so"
+loadmodule "corex.so"
+loadmodule "tm.so"
+loadmodule "tmx.so"
+loadmodule "sl.so"
+loadmodule "rr.so"
+loadmodule "pv.so"
+loadmodule "maxfwd.so"
+loadmodule "textops.so"
+loadmodule "xlog.so"
+loadmodule "sanity.so"
+loadmodule "siputils.so"
+loadmodule "dispatcher.so"
+loadmodule "nathelper.so"
+
+####### Module Parameters #########
+# ----- tm params -----
+modparam("tm", "failure_reply_mode", 3)
+modparam("tm", "fr_timer", 3000)
+modparam("tm", "fr_inv_timer", 40000)
+
+# ----- rr params -----
+modparam("rr", "enable_full_lr", 1)
+modparam("rr", "append_fromtag", 1)
+
+# ----- dispatcher params -----
+# AD-122 / Spec: SIP OPTIONS healthcheck every 2 seconds
+modparam("dispatcher", "list_file", "/etc/kamailio/dispatcher.list")
+modparam("dispatcher", "flags", 2)
+modparam("dispatcher", "ds_ping_interval", 2)
+modparam("dispatcher", "ds_probing_mode", 1)
+modparam("dispatcher", "ds_ping_from", "sip:kamailio-sbc@nowing.internal")
+modparam("dispatcher", "ds_ping_method", "OPTIONS")
+modparam("dispatcher", "ds_ping_latency_stats", 1)
+modparam("dispatcher", "ds_probing_threshold", 1)
+
+# ----- sanity params -----
+modparam("sanity", "default_checks", 17895)
+
+####### Routing Logic ########
+request_route {
+    # 1. Per-request initial sanity checks
+    if (!mf_process_maxfwd_header("10")) {
+        sl_send_reply("483", "Too Many Hops");
+        exit;
+    }
+
+    if (!sanity_check()) {
+        xlog("L_WARN", "[SBC] Malformed SIP request from $si:$sp - dropping\n");
+        exit;
+    }
+
+    # 2. Block malicious scanners and SIP bots
+    if ($ua =~ "(friendly-scanner|sipvicious|sipcli|VaxSIPUserAgent)") {
+        xlog("L_WARN", "[SBC] Blocked scanner User-Agent: $ua from $si:$sp\n");
+        sl_send_reply("403", "Forbidden");
+        exit;
+    }
+
+    # 3. IP Whitelist Verification (Carrier Trunk Validation & Anti-Fraud)
+    # Whitelisted: Localhost, private networks (Docker / internal VPC), and carrier whitelist
+    if (!($si =~ "^(127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[0-1])\.)")) {
+        xlog("L_WARN", "[SBC] Unauthorized SIP source IP: $si - 403 Forbidden\n");
+        sl_send_reply("403", "Forbidden - IP Not Authorized");
+        exit;
+    }
+
+    # 4. Handle SIP OPTIONS keepalive to Kamailio itself
+    if (is_method("OPTIONS")) {
+        if ($rU == $null || uri == myself) {
+            sl_send_reply("200", "Keepalive OK");
+            exit;
+        }
+    }
+
+    # 5. Handle In-Dialog Requests (ACK, BYE, CANCEL, PRACK, INFO)
+    if (has_totag()) {
+        if (loose_route()) {
+            t_relay();
+            exit;
+        }
+        if (is_method("ACK")) {
+            if (t_check_trans()) {
+                t_relay();
+                exit;
+            } else {
+                exit;
+            }
+        }
+        sl_send_reply("404", "Not here");
+        exit;
+    }
+
+    # 6. Handle CANCEL
+    if (is_method("CANCEL")) {
+        if (t_check_trans()) {
+            t_relay_cancel();
+        }
+        exit;
+    }
+
+    # 7. Codec Verification for INVITE (Invariant: G.711a PCMA 8kHz / Opus)
+    if (is_method("INVITE")) {
+        # Check for unsupported codecs: e.g. G.729 (payload 18) when PCMA (payload 8) or Opus is absent
+        if (has_body("application/sdp")) {
+            if (search_body("a=rtpmap:18 G729") && !search_body("a=rtpmap:8 PCMA") && !search_body("a=rtpmap:.*opus")) {
+                xlog("L_WARN", "[SBC] Audio Codec Mismatch: Unsupported G.729 from $si. Remote SDP: $rb\n");
+                sl_send_reply("488", "Not Acceptable Here");
+                exit;
+            }
+        }
+
+        # Record route for stateful dialog tracking
+        record_route();
+
+        # Select LiveKit SIP Gateway via round-robin (set 1, alg 4)
+        if (!ds_select_dst("1", "4")) {
+            xlog("L_ERR", "[SBC] No active LiveKit SIP Gateway available in dispatcher set 1\n");
+            sl_send_reply("503", "Service Unavailable - No Gateway Available");
+            exit;
+        }
+
+        xlog("L_INFO", "[SBC] Routing INVITE $rU to LiveKit SIP Gateway $du (source: $si)\n");
+        t_on_failure("DISPATCH_FAILOVER");
+        if (!t_relay()) {
+            sl_reply_error();
+        }
+        exit;
+    }
+
+    # 8. Relay any other SIP methods
+    if (!t_relay()) {
+        sl_reply_error();
+    }
+}
+
+# Failure route for automatic failover when a SIP Gateway node drops
+failure_route[DISPATCH_FAILOVER] {
+    if (t_is_canceled()) {
+        exit;
+    }
+
+    # 500/502/503/504 or branch timeout indicates gateway failure
+    if (t_check_status("500|502|503|504") || t_branch_timeout()) {
+        xlog("L_WARN", "[SBC] LiveKit SIP Gateway failure ($T_reply_code). Failing over to next destination.\n");
+        # Mark current destination as probing/inactive
+        ds_mark_dst("p");
+        if (ds_next_dst()) {
+            xlog("L_INFO", "[SBC] Failover to secondary LiveKit SIP Gateway: $du\n");
+            t_on_failure("DISPATCH_FAILOVER");
+            t_relay();
+            exit;
+        } else {
+            xlog("L_ERR", "[SBC] All LiveKit SIP Gateway nodes exhausted in dispatcher\n");
+            t_reply("503", "Service Unavailable - All Gateways Down");
+            exit;
+        }
+    }
+}
