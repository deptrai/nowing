+        return articles
+
+    monkeypatch.setattr(
+        "app.tasks.connector_indexers.rss_indexer.fetch_feed", _fake_fetch
+    )
+
+    await index_rss_feeds(
+        db_session,
+        db_rss_connector.id,
+        db_workspace.id,
+        str(db_user.id),
+    )
+
+    # Ensure the document is ready and content is searchable.
