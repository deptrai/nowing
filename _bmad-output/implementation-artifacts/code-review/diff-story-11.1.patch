+
+
+class _FakeAutomationWithReservedName:
+    id = 456
+    name = "My*Bot!"
+    workspace_id = 7
+
+
+def _fake_run(status: RunStatus, *, output=None, error=None):
+    return SimpleNamespace(id=7, status=status, output=output, error=error)
