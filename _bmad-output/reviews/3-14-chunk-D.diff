 @limiter.exempt
 async def health_check():
     """Lightweight liveness probe exempt from rate limiting."""
-    return {"status": "ok"}
+    return {"status": "ok", "build_id": _backend_build_id()}
 
 
 @app.get("/ready", tags=["health"])
