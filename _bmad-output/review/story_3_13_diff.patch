+
+    assert created == []
+    assert llm.ainvoke.await_count == 0
+    assert scraper_run.memory_extraction_status == "skipped"
+    assert scraper_run.memory_extraction_skip_reason == "missing_workspace"
diff --git a/nowing_backend/tests/integration/memory/test_run_memory_first_run_value.py b/nowing_backend/tests/integration/memory/test_run_memory_first_run_value.py
