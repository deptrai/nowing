+
+
+@pytest.mark.asyncio
+async def test_run_extraction_skips_llm_when_gate_blocks(db_session, scraper_run):
+    """AC-4: a blocking gate verdict prevents the LLM call."""
+    from app.services.memory.extract_budget import ExtractGateResult
