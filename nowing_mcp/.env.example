# Copy to .env (or set these in your MCP client config) and fill in your token.

# API key from Nowing (Settings -> API). Required.
NOWING_API_KEY=nw_pat_your_token_here

# Base URL of the Nowing backend. Defaults to http://localhost:8000
NOWING_BASE_URL=http://localhost:8000

# Optional: default workspace (search space) by name or id, so you don't have
# to select one each session.
# NOWING_WORKSPACE=My Research Space

# Optional overrides.
# NOWING_API_PREFIX=/api/v1
# NOWING_TIMEOUT=180
# NOWING_MCP_TRANSPORT=stdio
